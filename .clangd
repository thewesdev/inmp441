CompileFlags:
  Add: [
    -Wall,
    -Wextra,
    -isystem,
    /home/waslleynanferdes/.espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/picolibc/include,
    -isystem,
    /home/waslleynanferdes/.espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/lib/gcc/xtensa-esp-elf/15.2.0/include
  ]
  Remove: [
    -fno-shrink-wrap,
    -fstrict-volatile-bitfields,
    -fno-tree-switch-conversion,
    -fzero-init-padding-bits=all,
    -fno-malloc-dce,
    -Wno-old-style-declaration
  ]
  CompilationDatabase: build

Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add: [performance-*, bugprone-*]
    Remove: [
      readability-function-cognitive-complexity,
      readability-implicit-bool-conversion
    ]

Index:
  Background: Build
